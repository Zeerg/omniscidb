+            <button
+              type="button"
+              disabled={loading || (page + 1) * PAGE_SIZE >= results.count}
+              onClick={() => setPage(page + 1)}
+            >
+              Next
+            </button>
+          </div>
+        </section>
+        <section className="sc-inspector" aria-label="Source investigation">
