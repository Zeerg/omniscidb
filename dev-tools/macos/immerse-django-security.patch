+          ))}
+        </div>
+      )}
+      <div className="sc-workbench">
+        <section className="sc-queue" aria-label="Review queue">
+          <div className="sc-section-heading">
+            <h2>
+              {mode === "flows" ? "Source-to-sink review" : "Review queue"}
