+    width: 8px;
+    height: 8px;
+    margin-right: 6px;
+  }
+  .sc-workbench {
+    display: grid;
+    grid-template-columns: minmax(250px, 0.7fr) minmax(0, 2fr);
+    gap: 20px;
+    align-items: start;
+  }
+  .sc-queue {
+    min-width: 0;
+    border-top: 1px solid var(--sc-border);
+    padding-top: 10px;
+  }
+  .sc-queue-rows {
+    max-height: 780px;
+    overflow: auto;
+    margin-top: 8px;
+  }
+  .sc-signal {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    width: 100%;
+    background: none;
+    border: 0;
+    border-bottom: 1px solid var(--sc-border);
+    padding: 12px 6px;
+    text-align: left;
+    overflow-wrap: anywhere;
+  }
+  .sc-signal[aria-pressed="true"] {
+    background: var(--sc-panel);
+    border-left: 3px solid #a5c9ed;
+  }
+  .sc-signal strong {
+    font-size: 12px;
+    font-weight: 500;
+  }
+  .sc-signal span,
+  .sc-signal small {
+    font-size: 11px;
+  }
+  .sc-signal small {
+    color: var(--sc-muted);
+  }
+  .sc-pagination {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 10px;
+    margin-top: 10px;
+  }
+  .sc-inspector {
+    min-width: 0;
+    border-top: 1px solid var(--sc-border);
+    padding-top: 10px;
+  }
+  .sc-file-heading h2 {
+    overflow-wrap: anywhere;
+  }
+  .sc-evidence {
+    margin: 12px 0;
+    padding: 10px 12px;
+    background: var(--sc-panel);
+    border-left: 3px solid #a5c9ed;
+  }
+  .sc-evidence code {
+    white-space: pre-wrap;
+    overflow-wrap: anywhere;
+  }
+  .sc-evidence p {
+    color: var(--sc-muted);
+  }
+  .sc-source-layout {
+    display: grid;
+    grid-template-columns: minmax(210px, 0.7fr) minmax(0, 1.3fr);
+    gap: 16px;
+  }
+  .sc-map svg {
+    display: block;
+    width: 100%;
+    max-height: 440px;
+  }
+  .sc-map g {
+    cursor: pointer;
+  }
+  .sc-map text {
+    fill: #e3edf4;
+    font: 9px ui-monospace, monospace;
+    pointer-events: none;
+  }
+  .sc-map label,
+  .sc-map p {
+    font-size: 11px;
+    color: var(--sc-muted);
+  }
+  .sc-map input {
+    padding: 0;
+    vertical-align: middle;
+  }
+  .sc-source {
+    height: 440px;
+    overflow: auto;
+    background: var(--sc-panel);
+    border: 1px solid var(--sc-border);
+    padding: 8px 0;
+  }
+  .sc-source > div {
+    display: flex;
+    min-width: max-content;
+    line-height: 19px;
+  }
+  .sc-source > div > span {
+    width: 45px;
+    flex-shrink: 0;
+    color: var(--sc-muted);
+    text-align: right;
+    padding-right: 12px;
+    user-select: none;
+  }
+  .sc-source code {
+    white-space: pre;
+    padding-right: 12px;
+  }
+  .sc-source .is-selected {
+    background: #384f63;
+    color: #fff;
+  }
+  .sc-cst p {
+    overflow-wrap: anywhere;
+    color: var(--sc-muted);
+  }
+  .sc-relations {
+    margin-top: 14px;
+  }
+  .sc-relations > p {
+    color: var(--sc-muted);
+  }
+  .sc-relation {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    border-bottom: 1px solid var(--sc-border);
+    padding: 8px 0;
+  }
+  .sc-relation > span {
+    font-size: 11px;
+    color: var(--sc-muted);
+  }
+  .sc-relation button {
+    text-align: left;
+    background: none;
+    border: 0;
+    color: #a5c9ed;
+    padding: 0;
+    overflow-wrap: anywhere;
+  }
+  .sc-relation small,
+  .sc-relation code {
+    overflow-wrap: anywhere;
+  }
+  details {
+    border-top: 1px solid var(--sc-border);
+    margin-top: 12px;
+    padding-top: 10px;
+  }
+  summary {
+    cursor: pointer;
+    color: var(--sc-muted);
+  }
+  .sc-query pre {
+    white-space: pre-wrap;
+    overflow-wrap: anywhere;
+  }
+  .sc-error {
+    padding: 12px;
+    margin: 12px 0;
+    border: 1px solid #c98d7e;
+    background: var(--sc-panel);
+  }
+
+  @media (max-width: 1250px) {
+    .sc-source-layout {
+      grid-template-columns: 1fr;
+    }
+    .sc-map svg {
+      max-height: 280px;
+    }
+  }
+  @media (max-width: 850px) {
+    padding: 62px 16px 24px;
+    .sc-workbench {
+      grid-template-columns: 1fr;
+    }
+    .sc-queue-rows {
+      max-height: 320px;
+    }
+    .sc-stats {
+      gap: 20px;
+    }
+  }
+}
+
+body.light2-mode .security-code-page {
+  --sc-bg: #f7f9fb;
+  --sc-panel: #edf1f5;
+  --sc-border: #c0cad5;
+  --sc-text: #253447;
+  --sc-muted: #506078;
+  a,
+  .sc-relation button {
+    color: #2b618e;
+  }
+}
+
+@media (max-width: 850px) {
+  html:has(.security-code-page),
+  body:has(.security-code-page) {
+    min-width: 0;
+    min-height: 0;
+  }
+
+  body:has(.security-code-page) {
+    .app-content,
+    .main-nav-logo,
+    .nav-buttons {
+      min-width: 0;
+    }
+    .main-nav-logo {
+      margin-right: 0;
+    }
+    .combo-logo {
+      padding: 0 6px;
+      gap: 0;
+      > :not(.heavy-logo) {
+        display: none;
+      }
+    }
+    .security-code-page details {
+      overflow-wrap: anywhere;
+    }
+  }
+}
