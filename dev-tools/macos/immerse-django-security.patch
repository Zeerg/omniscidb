+                        flowId: signal.flow_id,
+                        signal: null
+                      })
+                    : selectSignal(signal)
+                }
+              >
+                <span style={{ color: ROLE_COLORS[signal.signal_role] }}>
+                  {signal.category} /{" "}
+                  {mode === "flows" ? signal.source_kind : signal.signal_role}
