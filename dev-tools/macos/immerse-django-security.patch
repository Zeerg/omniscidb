+                            (selection.signal
+                              ? selection.signal.end_line
+                              : selection.line)
+                            ? "is-selected"
+                            : ""
+                        }
+                      >
+                        <span>{index + 1}</span>
+                        <code>{line || " "}</code>
+                      </div>
+                    ))}
+                  </div>
+                </div>
+              </div>
+              <details className="sc-cst">
+                <summary>
+                  Syntax containment at this line ({nodes.length} nodes, capped
+                  at 100)
+                </summary>
+                <p>
+                  {nodes
+                    .map(
+                      (node) =>
+                        `${node.node_kind} [${node.start_line}:${node.end_line}]`
+                    )
+                    .join(" / ")}
+                </p>
+              </details>
+              <section className="sc-relations">
+                <h3>Call candidates</h3>
+                <p>
+                  Static references only. Resolved names are still candidates;
+                  dynamic dispatch and data flow are not proven. Up to 100
+                  references.
+                </p>
+                {!relations.length && (
+                  <p>No call candidates were indexed for this scope.</p>
+                )}
+                {relations.map((edge) => {
+                  const outgoing = edge.source_id === selection.symbolId
+                  const fileId = outgoing
+                    ? edge.target_file_id
+                    : edge.source_file_id
+                  const symbolId = outgoing ? edge.target_id : edge.source_id
+                  return (
+                    <div className="sc-relation" key={edge.edge_id}>
+                      <span>
+                        {outgoing ? "Outgoing" : "Incoming"} | {edge.resolution}
+                      </span>
+                      {fileId ? (
+                        <button
+                          type="button"
+                          onClick={() =>
+                            setSelection({
+                              fileId,
+                              symbolId,
+                              line: outgoing
+                                ? edge.target_line
+                                : edge.start_line,
+                              signal: null
+                            })
+                          }
+                        >
+                          {outgoing ? edge.target_name : edge.source_name}
+                        </button>
+                      ) : (
+                        <code>{edge.target_name}</code>
+                      )}
+                      <small>{edge.evidence}</small>
+                    </div>
+                  )
+                })}
+              </section>
+              <details>
+                <summary>Source integrity</summary>
+                <p>
+                  SHA-256: <code>{source.file.sha256}</code>
+                </p>
+                <p>
+                  {source.file.line_count} lines | {source.file.node_count}{" "}
+                  named syntax nodes | {source.file.symbol_count} scopes
+                </p>
+              </details>
+            </>
+          )}
+          {!source && !sourceLoading && (
+            <p>Select a review signal to inspect its source.</p>
+          )}
+        </section>
+      </div>
+      <details className="sc-query">
+        <summary>HeavyDB queries for the review queue</summary>
+        <pre>{executedSql.join(";\n\n")}</pre>
+      </details>
+    </main>
+  )
+}
