@@ -0,0 +1,47 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import React from "react"
+import { render, screen } from "@testing-library/react"
+import { Provider } from "react-redux"
+import { createStore } from "redux"
+import { Router, Route, Switch } from "react-router-dom"
+import { createMemoryHistory } from "history"
+import AuthProtected from "routes/auth-protected"
+
+function open(valid) {
+  const history = createMemoryHistory({
+    initialEntries: ["/heavyai/security-code?file=3&line=15"]
+  })
+  const child = jest.fn(() => <div>Private source view</div>)
+  render(
+    <Provider store={createStore(() => ({ session: { valid } }))}>
+      <Router history={history}>
+        <Switch>
+          <Route path="/:database/security-code">
+            <AuthProtected>{React.createElement(child)}</AuthProtected>
+          </Route>
+          <Route path="/:database/login">
+            <div>Sign in</div>
+          </Route>
+        </Switch>
+      </Router>
+    </Provider>
+  )
+  return { history, child }
+}
+
+it("does not mount the source view without a valid session", () => {
+  const { history, child } = open(false)
+  expect(history.location.pathname).toBe("/heavyai/login")
+  expect(history.location.state.from.search).toBe("?file=3&line=15")
+  expect(child).not.toHaveBeenCalled()
+  expect(screen.getByText("Sign in")).toBeInTheDocument()
+})
+
+it("allows a valid session through the existing authentication boundary", () => {
+  const { history, child } = open(true)
+  expect(history.location.pathname).toBe("/heavyai/security-code")
+  expect(child).toHaveBeenCalled()
+  expect(screen.getByText("Private source view")).toBeInTheDocument()
+})
diff --git a/src/components/security-code/queries.js b/src/components/security-code/queries.js
new file mode 100644
index 0000000..99a511c
--- /dev/null
+++ b/src/components/security-code/queries.js
@@ -0,0 +1,106 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+export const PAGE_SIZE = 100
+
+export function sqlText(value) {
+  return `'${String(value).replace(/\0/g, "").replace(/'/g, "''")}'`
+}
+
+export function sqlId(value) {
+  const id = Number(value)
+  if (!Number.isSafeInteger(id) || id <= 0) {
+    throw new Error("Invalid source identifier")
+  }
+  return id
+}
+
+export function signalWhere(filters) {
+  const conditions = ["1=1"]
+  for (const [key, column] of [
+    ["category", "category"],
+    ["role", "signal_role"],
+    ["package", "package_name"]
+  ]) {
+    if (filters[key]) {
+      conditions.push(`${column}=${sqlText(filters[key])}`)
+    }
+  }
+  if (filters.search.trim()) {
+    const pattern = sqlText(`%${filters.search.trim().toLowerCase()}%`)
+    conditions.push(
+      `(LOWER(qualified_name) LIKE ${pattern} OR LOWER(source_path) LIKE ${pattern})`
+    )
+  }
+  return conditions.join(" AND ")
+}
+
+export function signalQueries(filters, page) {
+  if (!Number.isSafeInteger(page) || page < 0) {
+    throw new Error("Invalid result page")
+  }
+  const where = signalWhere(filters)
+  return [
+    `SELECT COUNT(*) AS n FROM django_sec_signals WHERE ${where}`,
+    `SELECT * FROM django_sec_signals WHERE ${where} ORDER BY source_path,start_line,signal_id LIMIT ${PAGE_SIZE} OFFSET ${
+      page * PAGE_SIZE
+    }`
+  ]
+}
+
+export function flowQueries(filters, page) {
+  if (!Number.isSafeInteger(page) || page < 0) {
+    throw new Error("Invalid result page")
+  }
+  const where =
+    signalWhere({ ...filters, role: "" }) +
+    (filters.origin ? ` AND source_kind=${sqlText(filters.origin)}` : "")
+  return [
+    `SELECT COUNT(*) AS n FROM django_sec_flows WHERE ${where}`,
+    `SELECT * FROM django_sec_flows WHERE ${where} ORDER BY source_kind DESC,source_path,sink_line,flow_id LIMIT ${PAGE_SIZE} OFFSET ${
+      page * PAGE_SIZE
+    }`
+  ]
+}
+
+export function sourceQueries(fileId, flowId) {
+  const id = sqlId(fileId)
+  return [
+    `SELECT * FROM django_sec_files WHERE file_id=${id}`,
+    `SELECT * FROM django_sec_symbols WHERE file_id=${id} ORDER BY depth,start_line,symbol_id LIMIT 2000`,
+    `SELECT * FROM django_sec_signals WHERE file_id=${id} ORDER BY start_line,signal_id LIMIT 2000`,
+    ...(flowId
+      ? [
+          `SELECT * FROM django_sec_flows WHERE flow_id=${sqlId(
+            flowId
+          )} LIMIT 1`
+        ]
+      : [])
+  ]
+}
+
+export function relationQuery(symbolId) {
+  const id = sqlId(symbolId)
+  return `SELECT e.edge_id,e.source_id,e.target_id,e.target_name,e.resolution,e.edge_kind,e.start_line,e.evidence,s.qualified_name AS source_name,s.file_id AS source_file_id,t.file_id AS target_file_id,t.start_line AS target_line FROM django_sec_edges e JOIN django_sec_symbols s ON e.source_id=s.symbol_id LEFT JOIN django_sec_symbols t ON e.target_id=t.symbol_id WHERE (e.source_id=${id} OR e.target_id=${id}) AND e.edge_kind IN ('call','decorator') ORDER BY e.source_id,e.start_line LIMIT 100`
+}
+
+export function nodeQuery(fileId, line) {
+  return `SELECT node_id,node_kind,depth,start_line,end_line FROM django_sec_nodes WHERE file_id=${sqlId(
+    fileId
+  )} AND start_line<=${sqlId(line)} AND end_line>=${sqlId(
+    line
+  )} ORDER BY depth,node_id LIMIT 100`
+}
+
+export function sourceUrl(commit, path, line) {
+  if (!/^[a-f0-9]{40}$/.test(commit)) {
+    return null
+  }
+  const parts = String(path).split("/")
+  if (parts[0] !== "django" || parts.some((part) => !part || part === "..")) {
+    return null
+  }
+  return `https://github.com/django/django/blob/${commit}/${parts
+    .map(encodeURIComponent)
+    .join("/")}#L${sqlId(line)}`
+}
