@@ -0,0 +1,74 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import {
+  flowQueries,
+  nodeQuery,
+  signalQueries,
+  sourceQueries,
+  sourceUrl,
+  sqlId,
+  sqlText
+} from "./queries"
+
+const filters = { category: "", role: "", package: "", search: "" }
+
+describe("security source queries", () => {
+  it("keeps user text inside a quoted SQL value", () => {
+    expect(sqlText("x'; DROP TABLE django_sec_files; --")).toBe(
+      "'x''; DROP TABLE django_sec_files; --'"
+    )
+    const [count] = signalQueries({ ...filters, search: "O'Brien" }, 0)
+    expect(count).toContain("%o''brien%")
+    expect(count).not.toContain("%O'Brien%")
+  })
+
+  it.each([0, -1, 1.2, "1 OR 1=1", Infinity, null])(
+    "rejects invalid source IDs: %s",
+    (id) => {
+      expect(() => sqlId(id)).toThrow("Invalid source identifier")
+    }
+  )
+
+  it("uses bounded queries with explicit filter and pagination values", () => {
+    const [count, rows] = signalQueries(
+      { ...filters, category: "SQL", role: "control" },
+      2
+    )
+    expect(count).toContain("category='SQL' AND signal_role='control'")
+    expect(rows).toContain("LIMIT 100 OFFSET 200")
+    expect(sourceQueries(3)[0]).toContain("file_id=3")
+    expect(nodeQuery(3, 25)).toContain("start_line<=25 AND end_line>=25")
+    expect(() => signalQueries(filters, -1)).toThrow()
+  })
+
+  it("only links to a pinned Django source URL", () => {
+    const commit = "a".repeat(40)
+    expect(sourceUrl(commit, "django/http/request.py", 5)).toBe(
+      `https://github.com/django/django/blob/${commit}/django/http/request.py#L5`
+    )
+    expect(sourceUrl("main", "django/http/request.py", 5)).toBeNull()
+    expect(sourceUrl(commit, "django/../secret.py", 5)).toBeNull()
+    // eslint-disable-next-line no-script-url
+    expect(sourceUrl(commit, "javascript:alert(1)", 5)).toBeNull()
+  })
+
+  it("filters local flows without treating signal roles as flow columns", () => {
+    const [count, rows] = flowQueries(
+      { ...filters, role: "control", origin: "HTTP request", category: "SQL" },
+      1
+    )
+    expect(count).toContain("source_kind='HTTP request'")
+    expect(count).toContain("category='SQL'")
+    expect(count).not.toContain("signal_role")
+    expect(rows).toContain("LIMIT 100 OFFSET 100")
+    expect(() => flowQueries(filters, -1)).toThrow()
+  })
+
+  it("loads a selected trace by a validated, bounded identifier", () => {
+    expect(sourceQueries(3, 7)[3]).toBe(
+      "SELECT * FROM django_sec_flows WHERE flow_id=7 LIMIT 1"
+    )
+    expect(() => sourceQueries(3, "1 OR 1=1")).toThrow()
+  })
+})
