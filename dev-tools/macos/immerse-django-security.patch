+++ b/src/components/security-code/security-code.js
@@ -0,0 +1,955 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+import React, { useEffect, useRef, useState } from "react"
+import { Link, useHistory, useParams } from "react-router-dom"
+import Services from "services/immerse"
+import { routeToDashboard } from "utils/routerPath"
+import {
+  PAGE_SIZE,
+  flowQueries,
+  nodeQuery,
+  relationQuery,
+  signalQueries,
+  sourceQueries,
+  sourceUrl
+} from "./queries"
+import "./styles.scss"
+
+const EMPTY_FILTERS = {
+  category: "",
+  role: "",
+  origin: "",
+  package: "",
+  search: ""
+}
+const ROLE_COLORS = {
+  input: "#7fa7cf",
+  boundary: "#cfaa75",
+  control: "#77b8a1",
+  "trust override": "#bb96cb"
+}
+const number = (value) => Number(value).toLocaleString("en-US")
+const query = (sql) => Services.get("DbCon").queryAsync(sql)
+
+function initialSelection() {
+  const params = new URLSearchParams(window.location.search)
+  const fileId = Number(params.get("file"))
+  const symbolId = Number(params.get("symbol"))
+  const line = Number(params.get("line"))
+  const flowId = Number(params.get("flow"))
+  return {
+    fileId: Number.isSafeInteger(fileId) && fileId > 0 ? fileId : null,
+    symbolId: Number.isSafeInteger(symbolId) && symbolId > 0 ? symbolId : null,
+    line: Number.isSafeInteger(line) && line > 0 ? line : 1,
+    flowId: Number.isSafeInteger(flowId) && flowId > 0 ? flowId : null,
+    signal: null
+  }
+}
+
+function ScopeMap({ file, symbols, signals, selection, onSelect }) {
+  const [zoom, setZoom] = useState(false)
+  const selected = symbols.find(
+    (symbol) => symbol.symbol_id === selection.symbolId
+  )
+  const low = zoom && selected ? selected.start_line : 1
+  const high = zoom && selected ? selected.end_line : file.line_count
+  const scale = (line) => 8 + ((line - low) / Math.max(1, high - low + 1)) * 380
+  return (
+    <section className="sc-map" aria-label="Code cross-section">
+      <div className="sc-section-heading">
+        <h3>Code cross-section</h3>
+        <label>
+          <input
+            type="checkbox"
+            checked={zoom}
+            onChange={(event) => setZoom(event.target.checked)}
+          />{" "}
+          Zoom to scope
+        </label>
+      </div>
+      <svg
+        viewBox="0 0 400 400"
+        aria-label="Source scopes positioned by line and nesting depth"
+      >
+        {symbols
+          .filter(
+            (symbol) => symbol.end_line >= low && symbol.start_line <= high
+          )
+          .map((symbol) => {
+            const depth = Math.max(
+              0,
+              symbol.depth - (zoom && selected ? selected.depth : 0)
+            )
+            const x = 8 + Math.min(depth, 8) * 28
+            const y = scale(Math.max(low, symbol.start_line))
+            const height = Math.max(
+              2,
+              scale(Math.min(high + 1, symbol.end_line + 1)) - y
+            )
+            return (
+              <g
+                key={symbol.symbol_id}
+                role="button"
+                tabIndex={0}
+                aria-label={`${symbol.qualified_name}, lines ${symbol.start_line} to ${symbol.end_line}`}
+                onClick={() => onSelect(symbol)}
+                onKeyDown={(event) => {
+                  if (event.key === "Enter") {
+                    onSelect(symbol)
+                  }
+                }}
+              >
+                <title>{`${symbol.qualified_name}\nLines ${symbol.start_line}-${symbol.end_line}; ${symbol.signal_count} review signals`}</title>
+                <rect
+                  x={x}
+                  y={y}
+                  width={370 - x}
+                  height={height}
+                  fill={symbol.symbol_kind === "class" ? "#304b60" : "#2e4249"}
+                  stroke={
+                    symbol.symbol_id === selection.symbolId
+                      ? "#d8e9fa"
+                      : "#627c89"
+                  }
+                  strokeWidth={
+                    symbol.symbol_id === selection.symbolId ? 2 : 0.5
+                  }
+                />
+                {height > 17 && (
+                  <text x={x + 5} y={y + 13}>
+                    {symbol.qualified_name.split(".").pop()}
+                  </text>
+                )}
+              </g>
+            )
+          })}
+        {signals
+          .filter(
+            (signal) => signal.start_line >= low && signal.start_line <= high
+          )
+          .map((signal) => (
+            <circle
+              key={signal.signal_id}
+              cx={385}
+              cy={scale(signal.start_line)}
+              r={3}
+              fill={ROLE_COLORS[signal.signal_role]}
+            >
+              <title>{`${signal.signal_role}: ${signal.rule_title}, line ${signal.start_line}`}</title>
+            </circle>
+          ))}
+      </svg>
+      <p>
+        Height shows source span. Indent shows scope nesting. Dots show review
+        signals, not vulnerability severity.
+      </p>
+    </section>
+  )
+}
+
+export default function SecurityCode() {
+  const { database } = useParams()
+  const history = useHistory()
+  const [overview, setOverview] = useState(null)
+  const [mode, setMode] = useState(() =>
+    new URLSearchParams(window.location.search).get("view") === "signals"
+      ? "signals"
+      : "flows"
+  )
+  const [filters, setFilters] = useState(EMPTY_FILTERS)
+  const [search, setSearch] = useState("")
+  const [page, setPage] = useState(0)
+  const [results, setResults] = useState({ count: 0, rows: [] })
+  const [selection, setSelection] = useState(initialSelection)
+  const [source, setSource] = useState(null)
+  const [relations, setRelations] = useState([])
+  const [nodes, setNodes] = useState([])
+  const [error, setError] = useState("")
+  const [loading, setLoading] = useState(true)
+  const [sourceLoading, setSourceLoading] = useState(false)
+  const [executedSql, setExecutedSql] = useState([])
+  const codeRef = useRef(null)
+  const preserveInitialLink = useRef(Boolean(selection.fileId))
+
+  useEffect(() => {
+    let active = true
+    setOverview(null)
+    setError("")
+    Promise.all([
+      query("SELECT * FROM django_sec_snapshot"),
+      query(
+        "SELECT category,COUNT(*) AS n FROM django_sec_signals GROUP BY category ORDER BY n DESC"
+      ),
+      query(
+        "SELECT signal_role,COUNT(*) AS n FROM django_sec_signals GROUP BY signal_role ORDER BY n DESC"
+      ),
+      query(
+        "SELECT package_name,COUNT(*) AS n FROM django_sec_signals GROUP BY package_name ORDER BY n DESC"
+      ),
+      query("SELECT * FROM django_sec_flow_snapshot"),
+      query(
+        "SELECT category,COUNT(*) AS n FROM django_sec_flows GROUP BY category ORDER BY n DESC"
+      ),
+      Services.get("DbCon").getDashboardsAsync()
+    ])
+      .then(
+        ([
+          snapshot,
+          categories,
+          roles,
+          packages,
+          flowSnapshot,
+          flowCategories,
+          dashboards
+        ]) => {
+          if (active) {
+            setOverview({
+              snapshot: snapshot[0],
+              categories,
+              roles,
+              packages,
+              flowSnapshot: flowSnapshot[0],
+              flowCategories,
+              dashboard: dashboards.find(
+                (row) =>
+                  row.dashboard_name ===
+                  `Django Security Atlas | ${snapshot[0].release_name}`
+              )
+            })
+          }
+        }
+      )
+      .catch((failure) => {
+        if (active) {
+          setError(
+            `Cannot read the Django index: ${failure.message || failure}`
+          )
+        }
+      })
+    return () => {
+      active = false
+    }
+  }, [database])
+
+  useEffect(() => {
+    let active = true
+    setLoading(true)
+    const statements = (mode === "flows" ? flowQueries : signalQueries)(
+      filters,
+      page
+    )
+    setExecutedSql(statements)
+    Promise.all(statements.map(query))
+      .then(([counts, rows]) => {
+        if (!active) {
+          return
+        }
+        setResults({ count: Number(counts[0].n), rows })
+        if (preserveInitialLink.current) {
+          preserveInitialLink.current = false
+        } else {
+          setSelection(
+            rows.length
+              ? {
+                  fileId: rows[0].file_id,
+                  symbolId: rows[0].symbol_id,
+                  line:
+                    mode === "flows" ? rows[0].sink_line : rows[0].start_line,
+                  flowId: mode === "flows" ? rows[0].flow_id : null,
+                  signal: mode === "signals" ? rows[0] : null
+                }
+              : {
+                  fileId: null,
+                  symbolId: null,
+                  line: 1,
+                  flowId: null,
+                  signal: null
+                }
+          )
+        }
+      })
+      .catch((failure) => {
+        if (active) {
+          setError(failure.message || String(failure))
+        }
+      })
+      .finally(() => {
+        if (active) {
+          setLoading(false)
+        }
+      })
+    return () => {
+      active = false
+    }
+  }, [database, filters, mode, page])
+
+  useEffect(() => {
+    let active = true
+    setSource(null)
+    setSourceLoading(false)
+    if (!selection.fileId) {
+      return () => {
+        active = false
+      }
+    }
+    setSourceLoading(true)
+    Promise.all(sourceQueries(selection.fileId, selection.flowId).map(query))
+      .then(([files, symbols, signals, flows = []]) => {
+        if (!active) {
+          return
+        }
+        if (!files.length) {
+          throw new Error("The selected source file does not exist")
+        }
+        const flow = flows[0]
+        if (
+          selection.flowId &&
+          (!flow ||
+            flow.file_id !== selection.fileId ||
+            flow.symbol_id !== selection.symbolId)
+        ) {
+          throw new Error(
+            "The selected trace does not match this file and scope"
+          )
+        }
+        setSource({
+          file: files[0],
+          lines: JSON.parse(files[0].source_json).split("\n"),
+          symbols,
+          signals,
+          flow: flow
+            ? {
+                ...flow,
+                steps: JSON.parse(flow.trace_json),
+                controls: JSON.parse(flow.controls_json)
+              }
